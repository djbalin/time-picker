# libsql connection string. Defaults to a local SQLite file when unset, which
# is all you need for local development.
DATABASE_URL="file:./db.sqlite"

# Only needed when DATABASE_URL points at a hosted Turso database.
# DATABASE_AUTH_TOKEN=""

# The site's real public URL once deployed. Used to build absolute URLs in
# metadata, the sitemap, and robots.txt. Defaults to localhost otherwise.
# NEXT_PUBLIC_SITE_URL="https://example.com"
