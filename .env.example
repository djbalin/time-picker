# Postgres connection string, e.g. from Supabase (Project Settings -> Database
# -> Connection string). Use the pooled "Transaction" connection string
# (port 6543) for the app at runtime, and the direct connection (port 5432)
# for running migrations (`pnpm db:migrate` / `db:push`) locally.
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres"

# The site's real public URL once deployed. Used to build absolute URLs in
# metadata, the sitemap, and robots.txt. Defaults to localhost otherwise.
# NEXT_PUBLIC_SITE_URL="https://example.com"
