{
  "name": "time-picker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "./scripts/dev.sh",
    "dev:next": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check",
    "format": "biome format --write",
    "test": "tsx ./scripts/checks.ts",
    "test:e2e": "playwright test --grep-invert @shots",
    "test:layout": "playwright test e2e/layout.spec.ts",
    "test:a11y": "playwright test e2e/a11y.spec.ts",
    "test:visual": "playwright test e2e/visual.spec.ts",
    "test:visual:update": "playwright test e2e/visual.spec.ts --update-snapshots",
    "test:audit": "playwright test -c e2e/audit-selftest/pw.config.ts",
    "test:report": "playwright show-report",
    "ui:shots": "tsx ./scripts/ui-shots.ts",
    "supabase": "supabase",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "drizzle-kit push --force && tsx ./lib/db/seed.ts"
  },
  "dependencies": {
    "@daypicker/react": "^10.0.1",
    "drizzle-orm": "1.0.0-rc.4",
    "next": "16.2.10",
    "next-intl": "^4.13.7",
    "postgres": "^3.4.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "2.2.0",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "1.0.0-rc.4",
    "supabase": "^2.116.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.0",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.11.1+sha512.e519b9f7639869dc8d5c3c5dfef73b3f091094b0a006d7317353c72b124e80e1afd429732e28705ad6bfa1ee879c1fce46c128ccebd3192101f43dd67c667912"
}
